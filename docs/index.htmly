<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
  <title>Sci-Fi Warzone</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
   body{
       background-img("/img/bg.png");
       repeat: no-repeat;
       positions: absolute;
       
   } *{box-sizing:border-box;margin:0;padding:0}
    body{overflow:hidden;background:#000;font-family:'Orbitron',Arial,sans-serif;color:#fff;user-select:none;-webkit-user-select:none}
    canvas{display:block;position:absolute;top:0;left:0}
    .screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#050a1a 0%,#000 100%);z-index:50}
    .screen.hidden{display:none!important}

    #menuScreen h1{font-size:clamp(22px,6vw,54px);font-weight:900;color:#00ffff;text-shadow:0 0 30px #00ffff,0 0 60px #0088ff;margin-bottom:6px;letter-spacing:4px}
    #menuScreen .sub{color:#0088ff;font-size:12px;letter-spacing:6px;margin-bottom:36px;opacity:.8}

    .btn{display:block;width:260px;padding:13px 20px;margin:6px;font-family:'Orbitron',Arial;font-size:13px;letter-spacing:2px;border:1px solid #00ffff;background:rgba(0,255,255,.05);color:#00ffff;cursor:pointer;transition:all .18s;outline:none}
    .btn:hover{background:rgba(0,255,255,.18);box-shadow:0 0 18px #00ffff44;transform:scale(1.03)}
    .btn.red{border-color:#ff4444;color:#ff4444}.btn.red:hover{background:rgba(255,68,68,.15)}
    .btn.grn{border-color:#00ff88;color:#00ff88}.btn.grn:hover{background:rgba(0,255,136,.15);box-shadow:0 0 18px #00ff8844}
    .btn.gold{border-color:#ffaa00;color:#ffaa00}.btn.gold:hover{background:rgba(255,170,0,.15)}

    input[type=text]{width:260px;padding:12px;margin:6px;background:rgba(0,255,255,.05);border:1px solid #0088ff;color:#fff;font-family:'Orbitron',Arial;font-size:13px;outline:none;text-align:center}
    input[type=text]::placeholder{color:#0088ff88}

    /* Ship select */
    #shipScreen h2,#diffScreen h2,#pauseScreen h2,#goScreen h2,#lbScreen h2,#npcScreen h2{font-size:clamp(16px,3.5vw,26px);color:#00ffff;text-shadow:0 0 20px #00ffff;margin-bottom:18px;letter-spacing:3px}
    .ship-cards{display:flex;gap:24px;flex-wrap:wrap;justify-content:center}
    .ship-card{border:1px solid #0088ff;padding:18px;text-align:center;cursor:pointer;transition:all .2s;background:rgba(0,136,255,.05);min-width:150px}
    .ship-card:hover,.ship-card.sel{border-color:#00ffff;background:rgba(0,255,255,.12);box-shadow:0 0 20px #00ffff44}
    .ship-card canvas{position:static;display:block;margin:0 auto 10px}
    .ship-card h3{color:#00ffff;font-size:12px;margin-bottom:4px}
    .ship-card p{color:#0088ff;font-size:10px}
    .ship-stat{color:#00ff88;font-size:10px;margin-top:4px}

    /* NPC Selector */
    .npc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;max-width:560px;width:100%}
    @media(max-width:500px){.npc-grid{grid-template-columns:repeat(2,1fr)}}
    .npc-card{border:1px solid #0088ff44;padding:12px 8px 10px;text-align:center;cursor:pointer;transition:all .22s;background:rgba(0,136,255,.04);position:relative}
    .npc-card:hover{background:rgba(0,255,255,.08);box-shadow:0 0 16px var(--nc,#00ffff)33;transform:scale(1.03)}
    .npc-card.sel{border-color:var(--nc,#00ffff);background:rgba(0,255,255,.1);box-shadow:0 0 24px var(--nc,#00ffff)55}
    .npc-num{position:absolute;top:5px;left:9px;font-size:15px;font-weight:900;font-family:'Orbitron',Arial;color:var(--nc,#00ffff);text-shadow:0 0 10px var(--nc,#00ffff)}
    .npc-img{width:56px;height:56px;object-fit:contain;margin:6px auto 6px;display:block;filter:sepia(1) hue-rotate(var(--nh,0deg)) saturate(3) brightness(1.4)}
    .npc-card h3{color:var(--nc,#00ffff);font-size:10px;margin-bottom:2px;letter-spacing:1px;text-shadow:0 0 8px var(--nc,#00ffff)}
    .npc-desc{color:#0088ff;font-size:9px;margin-bottom:3px;line-height:1.4}
    .npc-stat{color:#00ff8888;font-size:8px;letter-spacing:1px}

    /* Diff */
    .diff-row{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
    .dbtn{padding:16px 28px;border:1px solid;cursor:pointer;font-family:'Orbitron',Arial;font-size:12px;letter-spacing:2px;background:transparent;transition:all .2s}
    .dbtn.easy{border-color:#00ff88;color:#00ff88}.dbtn.norm{border-color:#00ffff;color:#00ffff}.dbtn.hard{border-color:#ff4444;color:#ff4444}
    .dbtn:hover{opacity:.7;transform:scale(1.05)}

    /* HUD */
    #hud{position:absolute;top:10px;left:10px;z-index:10;pointer-events:none}
    .hr{display:flex;align-items:center;gap:8px;margin-bottom:5px}
    .hl{font-size:9px;color:#0088ff;letter-spacing:2px;width:46px;flex-shrink:0}
    .hp-bg{width:130px;height:9px;background:rgba(255,255,255,.1);border:1px solid #00ffff22}
    #hpBar{height:100%;background:linear-gradient(90deg,#ff4444,#ffaa00,#00ff88);transition:width .12s}
    #hpNum,#scoreV,#waveV,#modeV,#nameV,#kdV{font-size:12px;color:#00ffff;text-shadow:0 0 8px #00ffff}
    #shieldBar{width:130px;height:5px;background:rgba(0,255,255,.2);border:1px solid #00ffff33;margin-top:2px;display:none}
    #shieldFill{height:100%;background:#00ffff;transition:width .12s}
    #hsDisp{font-size:11px;color:#ffaa00;text-shadow:0 0 8px #ffaa00}

    /* Radar */
    #radarCv{position:absolute;top:10px;right:10px;z-index:10;pointer-events:none;border-radius:50%}

    /* Kill feed */
    #killfeed{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:10;pointer-events:none;text-align:center;width:340px}
    .kfm{font-size:11px;letter-spacing:1px;animation:kfOut 3s forwards;padding:2px 0}
    .kfm.pvp{color:#ff8800;text-shadow:0 0 10px #ff8800}
    .kfm.sys{color:#00ffff88;font-size:10px}
    .kfm.own{color:#00ff88;text-shadow:0 0 10px #00ff88}
    @keyframes kfOut{0%{opacity:1;transform:translateY(0)}80%{opacity:1}100%{opacity:0;transform:translateY(-16px)}}

    /* Announce overlays */
    #waveAnn{position:absolute;top:38%;left:50%;transform:translate(-50%,-50%);font-size:clamp(18px,4vw,38px);color:#00ffff;text-shadow:0 0 30px #00ffff;letter-spacing:6px;z-index:10;pointer-events:none;opacity:0;transition:opacity .4s;text-align:center}
    #bossAnn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:clamp(20px,4.5vw,42px);color:#ff4444;text-shadow:0 0 40px #ff4444;letter-spacing:4px;z-index:10;pointer-events:none;opacity:0;transition:opacity .4s;text-align:center}

    /* Pause btn */
    #pauseBtn{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:10;background:transparent;border:1px solid #00ffff33;color:#00ffff88;font-family:'Orbitron',Arial;font-size:10px;padding:4px 12px;cursor:pointer;letter-spacing:2px;display:none}
    #pauseBtn:hover{background:rgba(0,255,255,.1);color:#00ffff}

    /* Boss HP */
    #bossHPWrap{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);width:300px;z-index:10;display:none;text-align:center}
    #bossLabel{font-size:10px;color:#ff4444;letter-spacing:3px;margin-bottom:4px;text-shadow:0 0 10px #ff4444}
    #bossHPBg{width:300px;height:12px;background:rgba(255,0,0,.15);border:1px solid #ff4444}
    #bossHPBar{height:100%;background:linear-gradient(90deg,#ff0000,#ff6600);transition:width .1s}

    /* Joystick */
    #joyWrap{position:absolute;bottom:22px;left:22px;width:110px;height:110px;z-index:20;display:none}
    #joyBase{width:110px;height:110px;border:2px solid #00ffff44;border-radius:50%;background:rgba(0,255,255,.04);position:relative}
    #joyStick{width:44px;height:44px;background:radial-gradient(circle,#00ffff66,#00ffff11);border:2px solid #00ffff;border-radius:50%;position:absolute;top:33px;left:33px}
    #shootBtn{position:absolute;bottom:28px;right:28px;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,#ff444455,#ff444411);border:2px solid #ff4444;display:none;align-items:center;justify-content:center;font-size:10px;letter-spacing:1px;color:#ff4444;cursor:pointer;z-index:20}

    /* ── PvP: DEATH SCREEN ── */
    #deathScreen{position:absolute;inset:0;background:rgba(0,0,0,.82);display:none;flex-direction:column;align-items:center;justify-content:center;z-index:40}
    #deathScreen h2{font-size:clamp(26px,5vw,48px);color:#ff4444;text-shadow:0 0 40px #ff4444;letter-spacing:5px;margin-bottom:10px}
    #deathKillerMsg{font-size:14px;color:#ff8800;letter-spacing:2px;margin-bottom:22px;text-shadow:0 0 10px #ff8800}
    #respawnBar{width:220px;height:8px;background:rgba(255,255,255,.1);border:1px solid #00ffff44;margin-bottom:10px}
    #respawnFill{height:100%;background:#00ffff;transition:width .1s linear}
    #respawnCountdown{font-size:11px;color:#00ffff88;letter-spacing:2px}

    /* ── PvP: SCOREBOARD (Tab) ── */
    #scoreboard{position:absolute;inset:0;background:rgba(0,0,0,.78);display:none;flex-direction:column;align-items:center;justify-content:center;z-index:35;pointer-events:none}
    #scoreboard h3{font-size:16px;color:#00ffff;letter-spacing:4px;margin-bottom:14px;text-shadow:0 0 15px #00ffff}
    #sbTable{width:380px;border-collapse:collapse}
    #sbTable th{font-size:9px;color:#0088ff;letter-spacing:2px;padding:4px 10px;border-bottom:1px solid #0088ff33;text-align:left}
    #sbTable td{font-size:12px;padding:6px 10px;border-bottom:1px solid #ffffff0a}
    #sbTable .you td{color:#00ffff;text-shadow:0 0 8px #00ffff}
    #sbTable .you td:first-child::after{content:" ◀";font-size:9px;color:#00ffff88}
    .sb-hint{font-size:9px;color:#ffffff33;margin-top:12px;letter-spacing:2px}
    .sb-rank{color:#ffaa00}.sb-kills{color:#ff8800}.sb-deaths{color:#ff4444}.sb-score{color:#00ff88}

    /* GAME OVER (solo) */
    #goScreen h2{color:#ff4444;text-shadow:0 0 30px #ff4444;letter-spacing:4px}
    .go-stats{color:#0088ff;font-size:13px;margin-bottom:26px;line-height:2.2;text-align:center}
    .go-stats span{color:#00ffff}
    #goHiMsg{font-size:11px;color:#ffff00;text-shadow:0 0 10px #ffff00;margin-bottom:10px;letter-spacing:2px;min-height:16px}

    /* Leaderboard */
    #lbList{margin:12px 0 20px;width:290px;max-height:260px;overflow-y:auto}
    .lb-row{display:flex;justify-content:space-between;width:290px;padding:7px 10px;border-bottom:1px solid #0088ff22;font-size:12px}
    .lb-row:nth-child(1){color:#ffff00}.lb-row:nth-child(2){color:#aaa}.lb-row:nth-child(3){color:#cc8833}

    /* Tab hint */
    #tabHint{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font-size:9px;color:#ffffff22;letter-spacing:2px;z-index:10;pointer-events:none;display:none}

    /* ── Circular countdown timer ── */
    #matchTimer{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:11;pointer-events:none;display:none;flex-direction:column;align-items:center}
    #matchTimer svg{filter:drop-shadow(0 0 8px var(--tc,#00ffff))}
    #timerTrack{fill:none;stroke:rgba(255,255,255,.08);stroke-width:5}
    #timerArc{fill:none;stroke:var(--tc,#00ffff);stroke-width:5;stroke-linecap:round;stroke-dasharray:226;stroke-dashoffset:0;transition:stroke-dashoffset .95s linear,stroke .5s}
    #timerNum{font-size:15px;font-weight:700;fill:var(--tc,#00ffff);text-anchor:middle;dominant-baseline:central;font-family:'Orbitron',Arial}
    #timerLabel{font-size:8px;letter-spacing:3px;color:#ffffff44;margin-top:2px}

    /* ── Name entry button on menu ── */
    #nameDisplay{display:flex;align-items:center;gap:12px;margin-bottom:6px;cursor:pointer;padding:11px 18px;border:1px solid #0088ff;background:rgba(0,136,255,.06);width:260px;transition:all .18s;user-select:none}
    #nameDisplay:hover{border-color:#00ffff;background:rgba(0,255,255,.1);box-shadow:0 0 14px #00ffff33}
    #nameDisplay .nd-icon{font-size:16px;color:#0088ff}
    #nameDisplay .nd-label{font-size:9px;color:#0088ff88;letter-spacing:2px;margin-bottom:2px}
    #nameDisplay .nd-value{font-size:13px;color:#00ffff;letter-spacing:1px;text-shadow:0 0 8px #00ffff}
    #nameDisplay .nd-edit{font-size:9px;color:#0088ff66;letter-spacing:1px;margin-left:auto}

    /* ── Name popup modal ── */
    #nameModal{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:200;display:none;align-items:center;justify-content:center}
    #nameModal.open{display:flex}
    .nm-box{background:linear-gradient(160deg,#050d1f,#000d1a);border:1px solid #00ffff;box-shadow:0 0 60px #00ffff22,inset 0 0 30px #00ffff08;padding:40px 36px 32px;width:clamp(280px,88vw,440px);position:relative;animation:nmIn .22s ease}
    @keyframes nmIn{from{transform:scale(.88) translateY(20px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
    .nm-corner{position:absolute;width:16px;height:16px;border-color:#00ffff;border-style:solid}
    .nm-corner.tl{top:8px;left:8px;border-width:2px 0 0 2px}
    .nm-corner.tr{top:8px;right:8px;border-width:2px 2px 0 0}
    .nm-corner.bl{bottom:8px;left:8px;border-width:0 0 2px 2px}
    .nm-corner.br{bottom:8px;right:8px;border-width:0 2px 2px 0}
    .nm-title{font-size:11px;color:#0088ff;letter-spacing:4px;margin-bottom:6px;text-align:center}
    .nm-head{font-size:clamp(16px,3vw,22px);color:#00ffff;text-shadow:0 0 20px #00ffff;letter-spacing:3px;text-align:center;margin-bottom:28px}
    .nm-field{margin-bottom:16px}
    .nm-field label{display:block;font-size:9px;color:#0088ff;letter-spacing:3px;margin-bottom:6px}
    .nm-field input{width:100%;padding:13px 14px;background:rgba(0,255,255,.04);border:1px solid #0088ff66;color:#fff;font-family:'Orbitron',Arial;font-size:14px;outline:none;letter-spacing:1px;transition:border-color .2s}
    .nm-field input:focus{border-color:#00ffff;box-shadow:0 0 12px #00ffff22}
    .nm-field input::placeholder{color:#0088ff44;font-size:11px;letter-spacing:2px}
    .nm-preview{font-size:10px;color:#00ff8888;letter-spacing:2px;text-align:center;min-height:16px;margin-bottom:20px}
    .nm-actions{display:flex;gap:10px}
    .nm-actions button{flex:1;padding:13px;font-family:'Orbitron',Arial;font-size:11px;letter-spacing:2px;border:1px solid;cursor:pointer;transition:all .18s;background:transparent}
    .nm-confirm{border-color:#00ff88;color:#00ff88}.nm-confirm:hover{background:rgba(0,255,136,.15);box-shadow:0 0 14px #00ff8844}
    .nm-cancel{border-color:#ff444488;color:#ff444488}.nm-cancel:hover{background:rgba(255,68,68,.1);border-color:#ff4444;color:#ff4444}
    .nm-err{font-size:9px;color:#ff4444;letter-spacing:1px;text-align:center;min-height:14px;margin-bottom:10px}

    /* ── PAUSE SETTINGS PANEL ── */
    #pauseMain,#settingsPanel{display:flex;flex-direction:column;align-items:center}
    #settingsPanel{width:clamp(280px,90vw,340px)}
    #settingsPanel h2{font-size:clamp(14px,3vw,22px);color:#00ffff;text-shadow:0 0 20px #00ffff;margin-bottom:14px;letter-spacing:3px}
    .set-section{width:100%;margin:6px 0;border-bottom:1px solid #00ffff11;padding-bottom:10px}
    .set-title{font-size:9px;color:#0088ff;letter-spacing:3px;margin-bottom:8px}
    .set-row{display:flex;align-items:center;justify-content:space-between;margin:5px 0;gap:10px}
    .set-label{font-size:11px;color:#00ffff88;letter-spacing:1px;flex-shrink:0}
    .tog-btn{padding:5px 14px;border:1px solid;font-family:'Orbitron',Arial;font-size:10px;letter-spacing:1px;cursor:pointer;transition:all .15s;background:transparent}
    .tog-btn.on{border-color:#00ff88;color:#00ff88;background:rgba(0,255,136,.12)}
    .tog-btn.off{border-color:#ff444488;color:#ff444488}
    .lvl-group,.diff-group{display:flex;gap:5px}
    .lvl-btn,.diff-btn2{padding:5px 10px;border:1px solid #0088ff55;color:#0088ff;font-family:'Orbitron',Arial;font-size:9px;letter-spacing:1px;cursor:pointer;transition:all .15s;background:transparent}
    .lvl-btn.sel,.diff-btn2.sel{border-color:#00ffff;color:#00ffff;background:rgba(0,255,255,.12);box-shadow:0 0 10px #00ffff33}
    .diff-btn2.easy-s{border-color:#00ff8855;color:#00ff8888}.diff-btn2.easy-s.sel{border-color:#00ff88;color:#00ff88;background:rgba(0,255,136,.12)}
    .diff-btn2.hard-s{border-color:#ff444455;color:#ff444488}.diff-btn2.hard-s.sel{border-color:#ff4444;color:#ff4444;background:rgba(255,68,68,.12)}
    .vol-wrap{display:flex;align-items:center;gap:8px;flex:1}
    .vol-slider{-webkit-appearance:none;appearance:none;flex:1;height:4px;background:rgba(0,255,255,.2);border-radius:2px;outline:none;cursor:pointer}
    .vol-slider::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:#00ffff;cursor:pointer;box-shadow:0 0 8px #00ffff}
    .vol-val{font-size:10px;color:#00ffff;width:28px;text-align:right}

    /* ── LAN MODAL ── */
    #lanModal{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:300;display:none;align-items:center;justify-content:center}
    #lanModal.open{display:flex}
    .lan-box{background:linear-gradient(160deg,#050d1f,#000d1a);border:1px solid #ff8800;box-shadow:0 0 60px #ff880022;padding:32px 28px 24px;width:clamp(290px,92vw,440px);animation:nmIn .22s ease}
    .lan-title{font-size:9px;color:#ff8800;letter-spacing:4px;margin-bottom:4px;text-align:center}
    .lan-head{font-size:clamp(14px,2.5vw,19px);color:#ffaa00;text-shadow:0 0 20px #ff8800;letter-spacing:3px;text-align:center;margin-bottom:20px}
    .lan-section{border:1px solid #ff880033;padding:14px;margin-bottom:14px;position:relative}
    .lan-section-label{position:absolute;top:-9px;left:10px;background:#050d1f;padding:0 6px;font-size:9px;letter-spacing:3px}
    .lan-host-label{color:#00ff88}
    .lan-join-label{color:#ff8800}
    .lan-ip-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
    .lan-ip-val{flex:1;font-size:12px;color:#00ffff;letter-spacing:1px;font-family:'Orbitron',Arial;background:rgba(0,255,255,.04);border:1px solid #00ffff33;padding:8px 10px}
    .lan-copy{padding:8px 12px;font-family:'Orbitron',Arial;font-size:9px;letter-spacing:1px;border:1px solid #00ff8866;color:#00ff88;cursor:pointer;background:transparent;transition:all .18s;white-space:nowrap}
    .lan-copy:hover{background:rgba(0,255,136,.1)}
    .lan-copy.copied{border-color:#00ffff;color:#00ffff}
    .lan-host-hint{font-size:9px;color:#00ff8866;letter-spacing:1px}
    .lan-loading{font-size:10px;color:#ff880066;letter-spacing:1px;animation:flicker 1s infinite}
    .lan-field label{display:block;font-size:9px;color:#ff8800;letter-spacing:3px;margin-bottom:6px}
    .lan-field input{width:100%;padding:10px 12px;background:rgba(255,136,0,.04);border:1px solid #ff880066;color:#fff;font-family:'Orbitron',Arial;font-size:12px;outline:none;letter-spacing:1px;transition:border-color .2s;box-sizing:border-box}
    .lan-field input:focus{border-color:#ffaa00;box-shadow:0 0 12px #ff880022}
    .lan-err{color:#ff4444;font-size:9px;letter-spacing:1px;margin-top:8px;min-height:14px}
    .lan-actions{display:flex;gap:10px;margin-top:14px}
    .lan-connect{flex:1;padding:12px;font-family:'Orbitron',Arial;font-size:11px;letter-spacing:2px;border:1px solid #ffaa00;color:#ffaa00;cursor:pointer;transition:all .18s;background:transparent}
    .lan-connect:hover{background:rgba(255,170,0,.15)}
    .lan-cancel{padding:12px 16px;font-family:'Orbitron',Arial;font-size:11px;letter-spacing:1px;border:1px solid #ff444488;color:#ff444488;cursor:pointer;transition:all .18s;background:transparent}
    .lan-cancel:hover{background:rgba(255,68,68,.1)}
    .lan-cancel:hover{border-color:#ff4444;color:#ff4444}
    .lan-err{font-size:9px;color:#ff4444;letter-spacing:1px;text-align:center;min-height:14px;margin-bottom:8px}
  </style>
</head>
<body>

<canvas id="starsBg"></canvas>

<!-- ═══ NAME POPUP MODAL ═══ -->
<div id="nameModal">
  <div class="nm-box">
    <div class="nm-corner tl"></div><div class="nm-corner tr"></div>
    <div class="nm-corner bl"></div><div class="nm-corner br"></div>
    <div class="nm-title">IDENTIFICATION</div>
    <div class="nm-head">PILOT REGISTRATION</div>
    <div class="nm-field">
      <label>FIRST NAME</label>
      <input type="text" id="nmFirst" p
